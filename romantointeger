class Solution:
    def romanToInt(self, s: str) -> int:
        translation = {
            'I': 1,
            'V': 5,
            'X': 10,
            'L': 50,
            'C': 100,
            'D': 500,
            'M': 1000
        }

        s  = s.replace('IV', 'IIII').replace('IX', 'VIIII').replace('XL', 'XXXX').replace('XC', 'LXXXX').replace('CD', 'CCCC').replace('CM', 'DCCCC')
        number = 0
        for char in s:
            number = number + translation[char]
        return number
roman_to_integer = Solution()
print(roman_to_integer.romanToInt("MMCMXLIX"))

