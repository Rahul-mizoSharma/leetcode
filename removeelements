class Solution:
    def removeElement(self, nums: list[int], val: int) -> int:
        i=0
        for j in range(len(nums)):
            if nums[j] != val:
                nums[i] = nums[j]
                i+=1
        return i
result = Solution()
print(result.removeElement([0,0,1,1,1,2,2,3,3,4], 2))
