class Solution:
    def isPalindrome(self, num: int) -> bool:
        if (num<0 or(num%10==0 and num!=0)):
            return False
        rev = 0
        while(num>rev):
            last_digit = num%10
            rev  = rev*10 +last_digit
            num = num //10
        if(num == rev or num == rev//10):
            return True
        return False
is_palindrome = Solution()
print(is_palindrome.isPalindrome(12121))
